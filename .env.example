# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN="ваш_токен_от_BotFather"

# --- Yandex Cloud (SpeechKit & LLM) ---
YANDEX_FOLDER_ID="ваш_folder_id"
YANDEX_API_KEY="ваш_api_ключ"

# --- Google API (Calendar & Sheets) ---
# Путь к файлу ключей внутри контейнера (не меняйте путь, если не знаете зачем)
GOOGLE_CREDENTIALS_FILE="mcp_server/credentials.json"
# ID таблицы из URL (между /d/ и /edit)
GOOGLE_SPREADSHEET_ID="ваш_id_google_таблицы"

# --- Search API (Optional, для поиска в интернете) ---
TAVILY_API_KEY="ваш_tavily_ключ_или_пусто"

# --- Internal Docker Services (НЕ МЕНЯТЬ ДЛЯ ЛОКАЛЬНОГО ЗАПУСКА) ---
# Адреса сервисов внутри docker-сети
OLLAMA_BASE_URL="http://ollama:11434"
REDIS_URL="redis://redis:6379/0"
MCP_SERVER_URL="http://mcp-server:8000"
CHROMA_DB_PATH="/app/chroma_db"

# --- Application Settings ---
LOG_LEVEL="INFO"
TZ="Europe/Moscow"
